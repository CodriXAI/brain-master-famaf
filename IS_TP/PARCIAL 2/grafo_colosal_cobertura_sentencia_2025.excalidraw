    {
      "id": "oztN7CVhiOSPEmGExQrsi",
      "type": "text",
      "x": 6754.209962434779,
      "y": -8542.342511233866,
      "width": 800,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
