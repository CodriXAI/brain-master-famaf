      "name": "Paso 3: startRow = 1 ; endRow = 1"
    },
    {
      "id": "Jmi4sx3ha8Y6m-k3lo_cQ",
      "type": "text",
      "x": 3922.5887955150547,
      "y": -9560.642483665339,
      "width": 1096.798978483289,
      "height": 775,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bOu",
      "roundness": null,
      "seed": 701852429,
      "version": 1729,
      "versionNonce": 859753101,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793135868436,
      "created": 1793135381146,
      "link": null,
      "locked": false,
      "text": "public static void main(String[] args) {\n    int[][] mat = {{1,2,-1, -4, -20}, {-8,-3,4,2,1},{3,8,10,1,3},{-4,-1,1,7,-6}};\n    int maxSum = Integer.MIN_VALUE, r1 = 0, c1 = 0, r2 = 0, c2 = 0;\n    \n    for(int startRow = 0; startRow < mat.length; startRow++) {\n        int [] temp = new int[mat[0].length];\n        for (int endRow = startRow; endRow < mat.length; endRow++) {\n            for(int j = 0; j < mat[0].length; j++) temp[j] += mat[endRow][j];\n    \n            int currMax = temp[0], globalMax = temp[0], startCol = 0, currStart = 0, endCol = 0;\n            for(int i = 1; i < temp.length; i++) {\n                if(temp[i] > currMax + temp[i]) {\n                    currMax = temp[i]; currStart = i;\n                } else {\n                    currMax += temp[i];\n                }\n                if(currMax > globalMax) {\n                    globalMax = currMax; startCol = currStart; endCol = i;\n                }\n            }\n    \n            if(globalMax > maxSum) {\n                maxSum = globalMax;\n                r1 = startRow; r2 = endRow; c1 = startCol; c2 = endCol;\n            }\n        } \n    }\n\n    System.out.println(\"Suma máxima: \" + maxSum);\n    System.out.println(\"Submatriz: [\" + r1 + \",\" + c1 + \"] a [\" + r2 + \",\" + c2 + \"]\")\n}",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "public static void main(String[] args) {\n    int[][] mat = {{1,2,-1, -4, -20}, {-8,-3,4,2,1},{3,8,10,1,3},{-4,-1,1,7,-6}};\n    int maxSum = Integer.MIN_VALUE, r1 = 0, c1 = 0, r2 = 0, c2 = 0;\n    \n    for(int startRow = 0; startRow < mat.length; startRow++) {\n        int [] temp = new int[mat[0].length];\n        for (int endRow = startRow; endRow < mat.length; endRow++) {\n            for(int j = 0; j < mat[0].length; j++) temp[j] += mat[endRow][j];\n    \n            int currMax = temp[0], globalMax = temp[0], startCol = 0, currStart = 0, endCol = 0;\n            for(int i = 1; i < temp.length; i++) {\n                if(temp[i] > currMax + temp[i]) {\n                    currMax = temp[i]; currStart = i;\n                } else {\n                    currMax += temp[i];\n                }\n                if(currMax > globalMax) {\n                    globalMax = currMax; startCol = currStart; endCol = i;\n                }\n            }\n    \n            if(globalMax > maxSum) {\n                maxSum = globalMax;\n                r1 = startRow; r2 = endRow; c1 = startCol; c2 = endCol;\n            }\n        } \n    }\n\n    System.out.println(\"Suma máxima: \" + maxSum);\n    System.out.println(\"Submatriz: [\" + r1 + \",\" + c1 + \"] a [\" + r2 + \",\" + c2 + \"]\")\n}",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
